# 复制为 .env 后按需修改（docker compose 自动读取同目录 .env）
# 复制命令：cp .env.example .env

# 强烈建议设置：API 密钥加密主密钥。
# 生成：openssl rand -hex 32
# 注意：一旦用它在"有密钥的配置"上保存过，之后丢失该值将无法解密已加密的密钥。
MT_MASTER_KEY=

# 每日定时雷达扫描：1 开启（默认）/ 0 关闭
SCHEDULER_ENABLED=1

# 配额硬拦截：默认关闭（配额仅展示不拦截）
ZB_QUOTA_ENABLED=0

# 演示模式闸门：设为 1 时允许 ?demo=1 直进工作台（生产环境请勿开启）
ZB_DEMO_ALLOWED=0

# 可选：显式指定平台超管密钥（不设则后端首次启动自动生成 data/.admin-secret）
MT_ADMIN_SECRET=

# 后端服务端口（默认 3300，一般不用改）
PORT=3300

# ---- LLM 供应商（OpenAI 兼容 /chat/completions 协议） ----
# 不设则默认 DeepSeek 官方 + deepseek-v4-flash。支持任意 OpenAI 兼容服务，例如
# 阿里云百炼 Token Plan（专属套餐）：
#   LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 注意：Token Plan 专属 key 必须配专属基地址，用 dashscope.aliyuncs.com 通用地址无法抵扣套餐额度。
# 平台「设置」页也可配置（设置页保存值优先于这里的环境变量）。
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=

# 前端服务端口（默认 3000；宿主机映射端口，容器内固定 3000）
WEB_PORT=3000

# 后端前置可信代理层数（X-Forwarded-For 解析用；当前部署为 zhibi-web 一层反代，默认 1。
# 改大可配合额外反代/CDN；直连部署设为 0 时忽略 XFF、直接取连接地址，防伪造绕过限流）
ZB_TRUSTED_PROXIES=1
