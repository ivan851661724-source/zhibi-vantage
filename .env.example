# 复制为 .env 后按需修改（docker compose 自动读取同目录 .env）
# 复制命令：cp .env.example .env

# 强烈建议设置：API 密钥加密主密钥。
# 生成：openssl rand -hex 32
# 注意：一旦用它在"有密钥的配置"上保存过，之后丢失该值将无法解密已加密的密钥。
MT_MASTER_KEY=

# 每日定时雷达扫描：1 开启（默认）/ 0 关闭
SCHEDULER_ENABLED=1

# 配额硬拦截：默认关闭（配额仅展示不拦截）
ZB_QUOTA_ENABLED=0

# 演示模式闸门：设为 1 时允许 ?demo=1 直进工作台（生产环境请勿开启）
ZB_DEMO_ALLOWED=0

# 后端服务端口（默认 3300，一般不用改）
PORT=3300

# 前端服务端口（默认 3000，Next.js 新前端入口）
WEB_PORT=3000
